# Notification service configuration.
#
# This service is the single outbound-messaging boundary. It absorbs the FCM
# fan-out that lived in karlo_be/karlo_order, the nodemailer calls made directly
# from five controllers, the in-app chat, and communication-service-be's
# WhatsApp, OTP and ticket features.

ENVIRONMENT=development

HTTP_PORT=5004
GRPC_PORT=6004

# --- MongoDB ----------------------------------------------------------------
# Must be a NEW, EMPTY database. The service refuses to start against the
# legacy monolith cluster or a database named prod/test/local, and prefixes
# every collection with `nt_`. The legacy `notifications` and `messages`
# collections still hold live data the monolith reads.
# See internal/config/guard.go.
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=karlo_notification
MONGO_TIMEOUT=10s

# --- Token verification -----------------------------------------------------
JWT_PUBLIC_KEY_FILE=../authentication-service/.keys/jwt-public.pem

# --- Service-to-service -----------------------------------------------------
SERVICE_TOKEN=                    # REQUIRED
ACCEPTED_SERVICE_TOKENS=          # REQUIRED, comma-separated
AUTH_GRPC_ADDR=localhost:6001

# --- Delivery ---------------------------------------------------------------
# Bounds concurrent outbound sends, so a fan-out to a large company does not
# open hundreds of simultaneous connections.
DELIVERY_WORKERS=8
# How long an idempotency key is honoured, making business-service retries safe.
DEDUPE_WINDOW=5m

# --- Push (Firebase Cloud Messaging, HTTP v1) -------------------------------
# The legacy server-key API is retired; this uses a service account.
# The channel is disabled unless both the project id and a credential are set.
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
# FCM_CREDENTIALS_JSON=           # inline alternative, for a secrets manager

# --- Email (SMTP) -----------------------------------------------------------
# Disabled unless SMTP_HOST and SMTP_FROM_EMAIL are both set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=Karlo
SMTP_FROM_EMAIL=

# --- WhatsApp Cloud API -----------------------------------------------------
# Disabled unless the token and phone number id are both set. OTP delivery
# depends on this channel.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- OTP --------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60s

# --- HTTP -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ----------------------------------------------------------------
# Logs are always written to stdout as JSON. Setting FLUENTD_HOST adds a second
# sink; leaving it unset is correct for local development and for platforms that
# collect stdout themselves.
#
# An unreachable collector degrades to stdout-only with a warning. It never
# stops the service from starting, and never blocks a request: shipping is
# asynchronous and bounded by FLUENTD_BUFFER_LIMIT.
LOG_LEVEL=info
# FLUENTD_HOST=localhost
FLUENTD_PORT=24224
FLUENTD_TAG_PREFIX=karlo
FLUENTD_ASYNC=true
FLUENTD_BUFFER_LIMIT=8388608
FLUENTD_TIMEOUT=3s

# --- Cache (Redis / ElastiCache) --------------------------------------------
# Optional. With REDIS_ADDR unset the service runs correctly against its
# database every time; nothing fails, it is simply slower.
#
# A cache failure is never a request failure: reads return a miss, writes are
# logged and dropped. The two primitives that cannot be faked — the login rate
# limiter and the idempotency claim — fall back to the database instead.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# Short by design: a cache that takes longer than this to answer is slower than
# the query it fronts, so waiting on it makes the request worse.
REDIS_TIMEOUT=200ms
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=2
# Required by ElastiCache when encryption in transit is enabled, which it should
# be in production.
REDIS_TLS=false
